{
  "name": "ai-fitness-backend-node",
  "version": "0.1.0",
  "private": true,
  "description": "API for the AI Fitness app: accounts, profile, generated workout + meal plans, logs and progress.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "seed": "node scripts/seed-demo.mjs",
    "build:library": "node scripts/build-library.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  }
}
