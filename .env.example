# Copy to .env and change the secret before deploying.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Hosted database (recommended for Render, whose disk is wiped on restart): create a free database at
# https://turso.tech, then copy its URL (libsql://…) and an auth token here. Leave empty to use the local file below.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local SQLite file, used when TURSO_DATABASE_URL is empty. Use :memory: for throwaway runs.
DB_FILE=./data/ai-fitness.db
# Comma-separated list of allowed web origins, or * for any (fine for local development).
CORS_ORIGIN=*
# Optional admin portal sign-in. If left empty, the portal offers a one-time "Create admin account" instead.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
