# Copy to .env and change the secret before deploying.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# SQLite file. Use :memory: for throwaway runs.
DB_FILE=./data/ai-fitness.db
# Comma-separated list of allowed web origins, or * for any (fine for local development).
CORS_ORIGIN=*
# Password-reset emails via Resend. Leave empty locally: reset codes are printed in the server console.
RESEND_API_KEY=
MAIL_FROM="AI Fitness <no-reply@yourdomain.com>"
# Admin portal sign-in (ai-fitness-admin-portal). The portal stays locked until both are set. Use a long password.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
